      0%, 100% { height: 8px; }
      50% { height: 28px; }
    }
  </style>
</head>
<body class="bg-gradient-to-br from-slate-900 via-sky-950 to-indigo-950 text-slate-800 min-h-screen antialiased flex flex-col justify-between selection:bg-sky-500 selection:text-white">

