# WeatherGPT Configuration

# Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Open-Meteo API Key (Optional for free tier; required for commercial/high volume tier from https://open-meteo.com/)
OPEN_METEO_API_KEY=

# Default Coordinates (Default: Chennai, India)
DEFAULT_LAT=13.0827
DEFAULT_LON=80.2707

# Cache & Server settings
DB_PATH=weather_cache.db
CACHE_EXPIRY_HOURS=3
PORT=8000
HOST=127.0.0.1
